.idea/
.vscode/
.xcodeshareddata/
.xcuserdata/

# Local-only workspace/legacy/reference artifacts (kept out of Git)
local/

# API keys
Secrets.xcconfig

# Keep local docs/notes/scratch files local only (track only root README, CLAUDE.md, and the
# shared Claude Code skills — those three are project documentation, not scratch).
*.md
!README.md
!CLAUDE.md
!.claude/skills/**/*.md
*.txt
*.docx
*.pdf

# Coach character sources. The Tripo FBX exports and the intermediate USDZ are ~79 MB and are
# not needed to build — only BoxingCoach/Resources/Coach/*.usdz is. Regenerate with
# Art/build_coach.py (tracked) from the FBX, which live outside git.
Art/*.fbx
Art/usdz/
